# ===================================================
# AI Assignment Evaluator - Environment Variables
# ===================================================

# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/ai_evaluator_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# JWT Secret Key (HMAC SHA-256 base64 or 32+ char secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Spring Profiles: 'dev' for in-memory H2 with MySQL mode, 'default' for MySQL
SPRING_PROFILES_ACTIVE=dev

# Frontend API URL (defaults to proxy /api)
VITE_API_BASE_URL=/api
